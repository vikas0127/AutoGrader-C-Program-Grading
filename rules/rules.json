{
  "version": 2,
  "problem": "instructor_selected_template",
  "time_limit_s": 1,
  "memory_limit_mb": 64,
  "compile_flags": [
    "-O2",
    "-Wall",
    "-Wextra",
    "-std=c11"
  ],
  "score_scale": 100,
  "missing_metric_policy": "renormalize_skipped",
  "grading_policy": {
    "all_correctness_tests_fail": {
      "enabled": true,
      "trigger_statuses": [
        "timeout",
        "crash",
        "execution_error"
      ],
      "score_cap": 20
    },
    "compile_failure_score": 0,
    "correctness_first": false,
    "first_pass_failure": {
      "enabled": true,
      "trigger_statuses": [
        "timeout",
        "crash",
        "error",
        "output_limit_exceeded"
      ],
      "score_cap": 20,
      "description": "If compile succeeds but the first-pass smoke execution fails, correctness analyzers are not run and the overall score is capped."
    }
  },
  "metrics": {
    "correctness": {
      "enabled": true,
      "analyzer": "io_tests",
      "weight": 0.25,
      "params": {},
      "threshold": 80
    },
    "syntax": {
      "enabled": true,
      "analyzer": "compiler_warnings",
      "weight": 0.15,
      "params": {
        "flags": [
          "-Wall",
          "-Wextra",
          "-Werror",
          "-std=c11"
        ]
      },
      "threshold": 80
    },
    "structure": {
      "enabled": true,
      "analyzer": "static_analysis",
      "weight": 0.1,
      "params": {
        "max_cyclomatic": 8,
        "max_function_length": 40
      },
      "threshold": 60
    },
    "modularity": {
      "enabled": true,
      "analyzer": "function_split",
      "weight": 0.1,
      "params": {
        "expect_helpers": true,
        "min_functions": 2
      },
      "threshold": 50
    },
    "logical": {
      "enabled": false,
      "analyzer": "edge_case_runner",
      "weight": 0.0,
      "params": {},
      "threshold": 80
    },
    "complexity": {
      "enabled": true,
      "analyzer": "complexity_estimator",
      "weight": 0.1,
      "params": {
        "required": "O(1)",
        "sizes": [
          1,
          10,
          100
        ]
      },
      "threshold": 70
    },
    "memory_safety": {
      "enabled": true,
      "analyzer": "sanitizer_run",
      "weight": 0.1,
      "params": {
        "flags": [
          "-fsanitize=address,undefined"
        ]
      },
      "threshold": 100
    },
    "readability": {
      "enabled": true,
      "analyzer": "readability_review",
      "weight": 0.1,
      "params": {
        "provider": "deterministic_heuristic",
        "temperature": 0,
        "seed": 42
      },
      "threshold": 70
    },
    "originality": {
      "enabled": true,
      "analyzer": "similarity_flag",
      "weight": 0.1,
      "params": {
        "corpus_dir": "submissions/",
        "flag_threshold": 0.85
      },
      "threshold": 15
    }
  },
  "execution": {
    "sandbox_mode": "off",
    "sandbox_options": [
      "off",
      "bubblewrap"
    ]
  }
}
